# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env*
!.env.example

# mastra local storage
mastra.db
mastra.db-*

# ARCA LibSQL / SQLite
arca.db
arca.db-*

# Generated SLNG / Vonage audio (not secrets, but binary noise)
.arca-audio/
mastra/public/*.db
mastra/public/*.db-*
mastra/public/*.duckdb
mastra/public/*.duckdb.wal
.mastra/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
