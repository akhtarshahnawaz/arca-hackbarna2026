{
  "name": "arca",
  "version": "2.0.0",
  "private": true,
  "description": "ARCA \u2014 wildfire values-at-risk coordination system",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm build:libs && pnpm --filter @arca/agent build && pnpm --filter @arca/web build",
    "build:libs": "pnpm --filter @arca/core build && pnpm --filter @arca/db build",
    "dev": "pnpm build:libs && pnpm -r --parallel dev",
    "dev:agent": "pnpm build:libs && pnpm --filter @arca/agent dev",
    "dev:web": "pnpm build:libs && pnpm --filter @arca/web dev",
    "start:agent": "pnpm --filter @arca/agent start",
    "start:web": "pnpm --filter @arca/web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @arca/db push",
    "demo:bundle": "pnpm --filter @arca/agent exec tsx scripts/make-demo-bundle.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
