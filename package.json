{
  "name": "arca",
  "version": "2.0.0",
  "private": true,
  "description": "ARCA — wildfire values-at-risk coordination system",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --filter @arca/core --filter @arca/db build && pnpm --filter @arca/agent build && pnpm --filter @arca/web build",
    "dev": "pnpm -r --parallel dev",
    "dev:agent": "pnpm --filter @arca/agent dev",
    "dev:web": "pnpm --filter @arca/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @arca/db push",
    "seed:replay": "pnpm --filter @arca/agent seed:replay"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
