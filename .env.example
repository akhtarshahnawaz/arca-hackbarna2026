# ARCA — copy to .env and fill in. Never commit the filled copy.

# ---------------------------------------------------------------------------
# DeepFire — satellite detections, clusters, static heat sources, fire spread
# app.deepfire.co -> Settings -> API clients -> Create
# ---------------------------------------------------------------------------
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
DEEPFIRE_BASE_URL=https://api.deepfire.co

# ---------------------------------------------------------------------------
# Talaia — exposure inventory (what is inside a perimeter)
# Mint an unlimited-tier key on your Talaia deployment.
# ---------------------------------------------------------------------------
TALAIA_URL=https://talaia.up.railway.app
TALAIA_API_KEY=

# ---------------------------------------------------------------------------
# Nebius Token Factory — agent reasoning and transcript extraction
# tokenfactory.nebius.com
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=openai/gpt-oss-120b
NEBIUS_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ---------------------------------------------------------------------------
# SLNG — outbound voice calls to sites, speech-to-text for voice notes
# app.slng.ai -> Projects -> Generate key
# ---------------------------------------------------------------------------
SLNG_API_KEY=
SLNG_AGENTS_URL=https://api.agents.slng.ai
SLNG_MEDIA_URL=https://eu-west.api.slng.ai
SLNG_AGENT_ID=
SLNG_REGION=eu-central

# ---------------------------------------------------------------------------
# Telegram — the coordinator's phone
# @BotFather -> /newbot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Comma-separated numeric chat ids. ONLY these can see incidents or approve.
COORDINATOR_TELEGRAM_CHAT_IDS=

# ---------------------------------------------------------------------------
# Safety rails — keep these tight during a demo or an exercise
# ---------------------------------------------------------------------------
# Comma-separated E.164 numbers ARCA may call. Empty = no outbound calls at all.
CALL_ALLOWLIST=
# When true every message and call is prefixed "SIMULACRO / EXERCISE".
EXERCISE_MODE=true
# Area ARCA watches. Default is Catalonia.
AOI_BBOX=0.15,40.50,3.35,42.90
# Minutes between watcher ticks.
WATCH_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Storage — omit DATABASE_URL to run fully in memory (fine for a demo)
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
PORT=4000
AGENT_PUBLIC_URL=http://localhost:4000
# Shared secret for the ops UI. Any non-empty value turns auth on.
OPS_TOKEN=
LOG_LEVEL=info
