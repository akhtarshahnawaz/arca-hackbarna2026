# =============================================================================
# ARCA — configuration template
#
# Copy to .env and fill in what you have and leave the rest blank:
# every integration is optional and ARCA degrades to whatever is configured.
# On boot it prints exactly what is missing and what that costs you.
#
# Nothing here is required to run the replay demo.
# =============================================================================


# -----------------------------------------------------------------------------
# DeepFire — satellite detections, clusters, static heat sources, fire spread
#
# app.deepfire.co -> Settings -> API clients -> Create
# Without these: no live detection. Replay still works fully.
# -----------------------------------------------------------------------------
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
DEEPFIRE_BASE_URL=https://api.deepfire.co


# -----------------------------------------------------------------------------
# Talaia — the exposure inventory (what is inside a fire perimeter)
#
# Use an unlimited-tier key: a six-hour band of a large fire exceeds the free
# tier's 250 km² cap. ARCA splits oversized areas into tiles anyway, but a
# tiled answer is a degraded one and says so.
#
# Without this: incidents open detection-only, with no ranked list.
# -----------------------------------------------------------------------------
TALAIA_URL=https://talaia.up.railway.app
TALAIA_API_KEY=


# -----------------------------------------------------------------------------
# Nebius Token Factory — briefings and transcript extraction
#
# tokenfactory.nebius.com. Pick a model that supports tool calling and JSON
# schema:
#   curl -H "Authorization: Bearer $NEBIUS_API_KEY" \
#     "https://api.tokenfactory.nebius.com/v1/models?verbose=true" \
#     | jq '.data[] | {id, supported_features}'
#
# Without this: briefings use the deterministic template (same facts, plainer
# wording) and transcripts are not extracted.
# -----------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=openai/gpt-oss-120b
NEBIUS_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct


# -----------------------------------------------------------------------------
# SLNG — outbound voice calls to sites, speech-to-text for voice notes
#
# app.slng.ai -> Projects -> Generate key
# Create the voice agent once, then paste the id it prints:
#   pnpm --filter @arca/agent slng:create-agent
#
# Without this: approvals are recorded but no call is placed, and the timeline
# says so rather than reporting a success that did not happen.
# -----------------------------------------------------------------------------
SLNG_API_KEY=
SLNG_AGENT_ID=
SLNG_AGENTS_URL=https://api.agents.slng.ai
SLNG_MEDIA_URL=https://eu-west.api.slng.ai
SLNG_REGION=eu-central


# -----------------------------------------------------------------------------
# Telegram — the coordinator's phone
#
# @BotFather -> /newbot gives you the token and username.
# Generate the webhook secret with:  openssl rand -hex 16
#
# To find your chat id: start the app, message the bot, and it replies with
# that chat's id and nothing else. Paste it below and restart.
# Spanish mobile numbers are not chat ids.
#
# ONLY the ids listed here can see incident data or approve anything.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
COORDINATOR_TELEGRAM_CHAT_IDS=


# -----------------------------------------------------------------------------
# Safety rails
#
# These are the two settings that decide whether ARCA can phone a real person,
# and both default to the safe value. You have to opt in.
# -----------------------------------------------------------------------------

# Comma-separated E.164 numbers ARCA may dial, matched exactly.
# EMPTY MEANS NO OUTBOUND CALLS AT ALL — every approval opens a browser voice
# session instead, which exercises the whole workflow without dialling anyone.
# Put your own number here first.  Example: +34600000000
CALL_ALLOWLIST=

# Prefixes every message and call with "SIMULACRO / EXERCISE".
# Turn this off only when ARCA is genuinely being used on a real incident by
# people who know it is on.
EXERCISE_MODE=true


# -----------------------------------------------------------------------------
# What to watch
#
# Keep the bounding box tight. A broad-area query with a large limit and no
# other filter is the one shape that reliably exceeds DeepFire's 30-second
# query budget.
#
#   Catalonia          0.15,40.50,3.35,42.90
#   Spain + Balearics  -9.50,35.90,4.40,43.90
#   Portugal           -9.55,36.95,-6.18,42.15
# -----------------------------------------------------------------------------
AOI_BBOX=0.15,40.50,3.35,42.90
WATCH_INTERVAL_MINUTES=5

# How far ahead to model, and with how many ensemble members (1-50).
# Ten members is what makes "7 of 10 runs" readable to a person.
SPREAD_HORIZON_HOURS=6
SPREAD_ENSEMBLE_MEMBERS=10
# Only hotspots this recent are allowed to seed a simulation.
SPREAD_LOOKBACK_HOURS=12


# -----------------------------------------------------------------------------
# Storage
#
# Leave DATABASE_URL blank to run entirely in memory — fine for a demo, and
# state is lost on restart. A value that is set but unreachable fails loudly
# rather than silently falling back, because that is a misconfiguration.
#
#   postgresql://user:password@host:5432/arca
# -----------------------------------------------------------------------------
DATABASE_URL=


# -----------------------------------------------------------------------------
# Services
# -----------------------------------------------------------------------------
# The agent's port. The web app runs on WEB_PORT, kept separate because both
# Next and the agent read PORT, and one file cannot give them the same value.
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# An https:// non-localhost value switches Telegram from long-polling to
# webhook mode. Leave it as localhost for local development.
AGENT_PUBLIC_URL=http://localhost:4000

# Any non-empty value turns on API authentication. Generate one with:
#   openssl rand -hex 24
# Leave blank locally; set it before exposing the API to a network.
OPS_TOKEN=


# -----------------------------------------------------------------------------
# Web app
#
# NEXT_PUBLIC_* values are baked in at build time, so changing one needs a
# rebuild rather than a restart.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AGENT_URL=http://localhost:4000

# Raster tile template for the map background. Blank uses Esri's dark canvas,
# which needs no API key. A vector style is deliberately not used: it must load
# a sprite sheet and glyph ranges before MapLibre will expose a single layer,
# so a slow basemap takes the fire down with it.
#   e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_BASEMAP_TILES=
