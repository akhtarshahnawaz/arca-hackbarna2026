# ARCA connection template — blank values are intentional, not issued keys.
# Copy to .env.local and fill privately. Application code must load these names.
# Never commit .env.local.

DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
DEEPFIRE_API_BASE_URL=https://api.deepfire.co

# Public source configuration (not secrets)
CATALUNYA_FARMS_DATASET_ID=7bpt-5azk
CATALUNYA_FARMS_SCHEMA_URL=https://analisi.transparenciacatalunya.cat/api/views/7bpt-5azk
CATALUNYA_FARMS_SODA_URL=https://analisi.transparenciacatalunya.cat/resource/7bpt-5azk.json

# Public documentation only — Pyro-SDIS is smoke-detection training data, not used in Values-at-risk
PYRO_SDIS_DATASET_URL=https://huggingface.co/datasets/pyronear/pyro-sdis
HF_SMOKE_DATASET=pyronear/pyro-sdis
MTG_DATA_DIRECTORY=https://datalsasaf.lsasvcs.ipma.pt/PRODUCTS/MTG/MTFRPPixel/NATIVE/

# Optional future integration: Google Cloud authentication/allowlisting required.
GOOGLE_CLOUD_PROJECT=

# Nebius Token Factory — create the key in the Token Factory UI. Do not invent one.
# https://tokenfactory.nebius.com  ·  https://docs.tokenfactory.nebius.com/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Official catalog + Mastra Nebius list: cheap/fast instruct chat (30B MoE).
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=

# Unused by Mastra now (agents go through Token Factory). Leave blank.
OPENAI_API_KEY=
# Leave TURSO_* unset to use local file:./mastra.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# MASTRA_PLATFORM_ACCESS_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
VONAGE_FROM_NUMBER=
SLNG_API_KEY=
# Placeholder only. In .env.local use a Catalan wildfire cluster, not Tarragona industry.
# Example shape (not a live id): 00000000-0000-0000-0000-000000000000
DEMO_CLUSTER_ID=
DATABASE_URL=file:./arca.db
