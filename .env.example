# ARCA connection template — blank values are intentional, not issued keys.
# Copy to .env.local and fill privately. Never commit .env.local.

DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
DEEPFIRE_API_BASE_URL=https://api.deepfire.co

# Cross-check feeds. A hotspot two feeds agree on outranks the clock.
# Free NASA FIRMS key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SENSORS=VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT
FIRMS_DAY_RANGE=1
# Optional third feed: any GeoJSON point layer of active fires.
EFFIS_GEOJSON_URL=
# Match tuning: same fire within km and hours; site "near" a corroborated fire.
CROSSCHECK_MATCH_KM=3
CROSSCHECK_MATCH_HOURS=24
CROSSCHECK_SITE_KM=12

# Public source configuration (not secrets)
CATALUNYA_FARMS_DATASET_ID=7bpt-5azk
CATALUNYA_FARMS_SCHEMA_URL=https://analisi.transparenciacatalunya.cat/api/views/7bpt-5azk
CATALUNYA_FARMS_SODA_URL=https://analisi.transparenciacatalunya.cat/resource/7bpt-5azk.json

# Public documentation only — Pyro-SDIS is smoke-detection training data, not used in Values-at-risk
PYRO_SDIS_DATASET_URL=https://huggingface.co/datasets/pyronear/pyro-sdis
HF_SMOKE_DATASET=pyronear/pyro-sdis
MTG_DATA_DIRECTORY=https://datalsasaf.lsasvcs.ipma.pt/PRODUCTS/MTG/MTFRPPixel/NATIVE/

# Optional future integration: Google Cloud authentication/allowlisting required.
GOOGLE_CLOUD_PROJECT=

# Nebius Token Factory — create the key in the Token Factory UI. Do not invent one.
# https://tokenfactory.nebius.com  ·  https://docs.tokenfactory.nebius.com/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Official catalog + Mastra Nebius list: cheap/fast instruct chat (30B MoE).
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Telegram BotFather token. Local Mastra uses long-polling (no public webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Numeric Telegram chat id after /start — not a Spanish mobile number.
COORDINATOR_TELEGRAM_CHAT_ID=
TELEGRAM_BACKUP_CHAT_ID=
# Only needed if you later deploy Mastra on a public URL and switch to webhook mode.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Unused by Mastra now (agents go through Token Factory). Leave blank.
OPENAI_API_KEY=
# Leave TURSO_* unset to use local file:./mastra.db and file:./arca.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# MASTRA_PLATFORM_ACCESS_TOKEN=

# Sunday Galtea CLI (optional). Do not invent a key.
# GALTEA_API_KEY=

# Placeholder only. In .env.local use a Catalan wildfire cluster, not Tarragona industry.
# Example shape (not a live id): 00000000-0000-0000-0000-000000000000
DEMO_CLUSTER_ID=
DATABASE_URL=file:./arca.db

# Vonage Voice only (no video). Placeholders — do not invent keys.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
# Path to a gitignored PEM, not the key body. Example: .vonage/private.key
VONAGE_PRIVATE_KEY_PATH=
VONAGE_FROM_NUMBER=
# Public HTTPS base Vonage can reach. Localhost will not work. Use ngrok or a deploy.
VONAGE_VOICE_WEBHOOK_URL=

# SLNG TTS/STT (docs.slng.ai). Placeholder — do not invent a key.
SLNG_API_KEY=

# Sunday demo cast — fill privately in .env.local. Never put real digits here.
# DEMO_PHONE is the farmer number on REGA-B-1842. Not NEXT_PUBLIC_.
DEMO_PHONE=
DEMO_FARMER_NAME=
DEMO_RESIDENT_PHONE=
DEMO_RESIDENT_NAME=
# Telegram chat id after the resident sends /start. Not their mobile number.
DEMO_RESIDENT_TELEGRAM_CHAT_ID=
COORDINATOR_PHONE=
